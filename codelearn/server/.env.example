# MongoDB Connection String
# Get free cluster at https://cloud.mongodb.com (M0 free tier)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codelearn
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/codelearn

# JWT Secret - use any long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Gemini AI API Key
# Get free key at https://aistudio.google.com (no credit card needed)
# Free tier: 1,500 requests/day with gemini-1.5-flash model
GEMINI_API_KEY=your_gemini_api_key_here

# JDoodle API (Code Execution) — FREE 200 runs/day
# Sign up at https://www.jdoodle.com/compiler-api
# No credit card needed
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret
JUDGE0_API_KEY=your_rapidapi_key_here

# YouTube Data API v3 Key (optional)
# Get free key at https://console.cloud.google.com → Enable YouTube Data API v3
# Free tier: 10,000 units/day (each search = 100 units = 100 searches/day)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development
